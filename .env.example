# App Web Config
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_GEOSPATIAL_SERVICE_URL=http://localhost:8000
VITE_APP_TITLE="Salaahkaar Spatial Verification"

# Application API (Node.js)
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
GEOSPATIAL_SERVICE_URL=http://localhost:8000

# Geospatial Service (FastAPI)
GEOSPATIAL_PORT=8000
GEOSPATIAL_DEBUG=True
GEOSPATIAL_DATA_DIR=../../data

# PostgreSQL / PostGIS Database
POSTGRES_USER=salaahkaar_user
POSTGRES_PASSWORD=salaahkaar_password
POSTGRES_DB=salaahkaar_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://salaahkaar_user:salaahkaar_password@localhost:5432/salaahkaar_db

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=salaahkaar_secret
